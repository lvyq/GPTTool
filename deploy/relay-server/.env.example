ASTERGATE_RELAY_PORT=8790
ASTERGATE_SERVE_FRONTEND=false
ASTERGATE_ASSETS_DIR=/opt/gpttool-relay/public
ASTERGATE_GATEWAY_DIR=/opt/gpttool-relay/gateway
ASTERGATE_PUBLIC_URL=https://gpttool.example.com/remote/
ASTERGATE_DATABASE=/var/lib/gpttool-relay/state.json
ASTERGATE_SESSIONS=/var/lib/gpttool-relay/sessions.json
ASTERGATE_REGISTRATION_MODE=open

# Recommended production backend. Keep PostgreSQL bound to loopback or a
# private network and use a dedicated least-privilege account.
ASTERGATE_POSTGRES_HOST=127.0.0.1
ASTERGATE_POSTGRES_PORT=5432
ASTERGATE_POSTGRES_DATABASE=gpttool
ASTERGATE_POSTGRES_USER=gpttool_app
ASTERGATE_POSTGRES_PASSWORD=replace-with-a-long-random-password
