# Build-time defaults for a self-hosted GPTTool desktop build.
# Never commit real credentials, device tokens or production private keys.

GPTTOOL_RELAY_URL=wss://gpttool.example.com/remote/agent
GPTTOOL_UPDATE_MANIFEST_URL=https://updates.example.com/gpttool/latest.json
# Base64 DER-encoded Ed25519 public key. Leave empty to disable auto-update.
GPTTOOL_UPDATE_PUBLIC_KEY=

# Release tooling only
GPTTOOL_UPDATE_BASE_URL=https://updates.example.com/gpttool/
GPTTOOL_UPDATE_SIGNING_KEY=/absolute/path/outside/repository/update-signing-ed25519.pem
GPTTOOL_WEB_DEPLOY_HOST=deploy@example.com
GPTTOOL_WEB_DEPLOY_DIR=/opt/gpttool-relay/public/
