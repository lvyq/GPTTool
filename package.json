{
  "name": "gpttool-desktop",
  "version": "0.2.10",
  "description": "Cross-platform remote workspace for Codex",
  "author": "lvyq and GPTTool contributors",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lvyq/GPTTool.git"
  },
  "bugs": {
    "url": "https://github.com/lvyq/GPTTool/issues"
  },
  "keywords": [
    "codex",
    "remote-workspace",
    "electron",
    "app-server",
    "cdp",
    "self-hosted"
  ],
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:gateway": "node scripts/build-gateway.mjs",
    "build:web": "node scripts/build-web-ui.mjs",
    "build:backend": "npm run build --prefix backend",
    "build:all": "npm run build && npm run build:backend",
    "dev:web": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "check": "tsc --noEmit",
    "deploy:web": "node scripts/deploy-web-ui.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack": "npm run build && electron-builder",
    "release:feed": "node scripts/create-update-feed.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.1",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.gpttool.desktop",
    "productName": "GPTTool",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "node_modules/electron/LICENSE",
        "to": "LICENSE.electron.txt"
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
