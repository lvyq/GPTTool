# Public frontend origin and prefix; keep the trailing slash.
ASTERGATE_PUBLIC_URL=http://localhost:5173/remote/
ASTERGATE_RELAY_PORT=8790
# Default: no static files are served by this process.
ASTERGATE_SERVE_FRONTEND=false
ASTERGATE_DATABASE=.runtime/state.json
ASTERGATE_SESSIONS=.runtime/sessions.json
ASTERGATE_REGISTRATION_MODE=closed
# Optional database settings are documented in deploy/relay-server/.env.example.
# Secrets belong in this backend's ignored .env, NEVER in frontend source/build.
